# Copy to .env for local development. Never commit .env.
APP_ENV=development
APP_NAME=PRAVAAH API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://pravaah:pravaah@localhost:5432/pravaah

# Local development only. Use a unique, securely generated value outside development.
JWT_SECRET_KEY=local-development-only-change-this-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=30
