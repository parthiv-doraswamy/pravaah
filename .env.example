# Copy to .env for local development. Never commit .env.
APP_ENV=development
APP_NAME=PRAVAAH API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://pravaah:pravaah@localhost:5432/pravaah

# Local development only. Use a unique, securely generated value outside development.
JWT_SECRET_KEY=local-development-only-change-this-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Private local file storage for evidence attachments; default upload cap is 10 MiB.
EVIDENCE_STORAGE_DIR=./var/uploads
EVIDENCE_MAX_UPLOAD_BYTES=10485760

# Optional outbound email for the notification worker. Leave SMTP_HOST blank to keep
# notifications in the in-app queue without attempting email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
NOTIFICATION_WORKER_INTERVAL_SECONDS=300
